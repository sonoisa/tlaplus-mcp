{
  "name": "tlaplus-mcp",
  "version": "1.0.3",
  "author": "Isao Sonobe <sonoisa@gmail.com>",
  "license": "MIT",
  "description": "TLA+ model checking MCP server",
  "type": "module",
  "keywords": [
    "tlaplus",
    "mcp",
    "model-context-protocol"
  ],
  "main": "./build/server.js",
  "types": "./build/server.d.ts",
  "bin": {
    "tlaplus-mcp": "build/index.js"
  },
  "exports": {
    ".": {
      "types": "./build/server.d.ts",
      "import": "./build/server.js"
    }
  },
  "files": [
    "build",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonoisa/tlaplus-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sonoisa/tlaplus-mcp/issues"
  },
  "homepage": "https://github.com/sonoisa/tlaplus-mcp#readme",
  "scripts": {
    "clean": "rimraf build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node build/index.js",
    "test": "rimraf .test-build && tsc -p tsconfig.test.json && node --input-type=module -e \"import { copyFileSync } from 'node:fs'; copyFileSync('package.json', '.test-build/package.json');\" && cd .test-build && node --test",
    "pack:check": "pnpm pack --dry-run",
    "prepack": "pnpm run clean && pnpm test && pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.30.3"
}
